# Copy to infra/.env on the server (NEVER commit infra/.env)
# Generate secrets: openssl rand -hex 32

# --- Host paths / site ---
KEYANTONG_DATA_ROOT=/data/keyantong
SITE_ADDRESS=keyantong.online
NEXT_PUBLIC_SITE_URL=https://keyantong.online
NEXT_PUBLIC_GITHUB_OWNER=AquaGrove
NEXT_PUBLIC_GITHUB_REPO=keyantong
NEXT_PUBLIC_BBS_URL=
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_RAG_BASE=

# --- Postgres (internal only) ---
POSTGRES_USER=kt
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=keyantong

# --- Portal secrets ---
USER_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
INTERNAL_API_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ADMIN_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
EMAIL_DEV_ECHO=false
OPENALEX_MAILTO=ops@keyantong.online
OPENALEX_API_KEY=

# NCBI: keep server ascp OFF in cloud
NCBI_ALLOW_SERVER_ASCP=0

# --- RNAseq worker (enable with: --profile rnaseq-worker) ---
RNASEQ_JOB_MAX_BYTES=85899345920
RNASEQ_MAX_CONCURRENT=1
RNASEQ_QUEUE_MAX=8
RNASEQ_DISK_WATERMARK=85


# --- LLM Gateway (portal server-only; NEVER commit real keys) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_REASONING=deepseek-reasoner
LLM_DAILY_TOKEN_BUDGET=200000
LLM_DAILY_CALL_BUDGET=80
LLM_TIMEOUT_MS=45000
LLM_ALLOW_ANY_MODEL=0

# --- DeepSeek Harness profile (optional: --profile harness) ---
# Prefer SSH tunnel. For harness.keyantong.online set user + bcrypt hash (caddy hash-password).
HARNESS_BASIC_USER=
HARNESS_BASIC_HASH=
HARNESS_PROXY_USER=
HARNESS_PROXY_PASSWORD=
# Optional; often configure provider inside Harness UI instead
DSH_LLM_API_KEY=
DSH_LLM_BASE_URL=
