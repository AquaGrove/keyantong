# Example reverse proxy layout for production.
# Replace hostnames with your registered domain.

keyantong.com {
	reverse_proxy portal:3000
}

bbs.keyantong.com {
	reverse_proxy nodebb:4567
}

api.keyantong.com {
	handle_path /bridge* {
		uri strip_prefix /bridge
		reverse_proxy bridge:8000
	}
	handle_path /rag* {
		uri strip_prefix /rag
		reverse_proxy rag:8001
	}
}
