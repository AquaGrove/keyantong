# 科研通 KeyanTong — copy to .env and fill secrets (never commit .env)

# --- Data ---
POSTGRES_USER=kt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=keyantong
DATABASE_URL=postgres://kt:changeme@localhost:5432/keyantong
REDIS_URL=redis://localhost:6379/0

# --- Client portal (:3000, public) ---
NEXT_PUBLIC_BBS_URL=
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_RAG_BASE=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
PUBLIC_PORTAL_URL=http://127.0.0.1:3000
PORTAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_GITHUB_OWNER=AquaGrove
NEXT_PUBLIC_GITHUB_REPO=keyantong
# Optional: raise GitHub API rate limits for admin GitHub panels
GITHUB_TOKEN=

# --- Admin console (:3001, private / localhost only) ---
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=replace-with-long-random-string

# --- Forum ---
NODEBB_URL=http://localhost:4567
FORUM_BASE_URL=http://localhost:4567
FORUM_API_KEY=changeme
FORUM_WEBHOOK_SECRET=dev-secret

# --- RAG / LLM ---
LLM_API_KEY=changeme
LLM_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=changeme
EMBEDDING_PROVIDER=api
AI_SUGGEST_ENABLED=false

# --- Object storage (later) ---
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
