# Local portal env (copy to apps/portal/.env.local). Never commit secrets.

DATA_DIR=../../data
USER_SESSION_SECRET=dev-user-secret-change-me
INTERNAL_API_SECRET=dev-internal-secret-change-me
REDIS_URL=

# LLM Gateway — server only
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_REASONING=deepseek-reasoner
LLM_DAILY_TOKEN_BUDGET=200000
LLM_DAILY_CALL_BUDGET=80
LLM_TIMEOUT_MS=45000
LLM_ALLOW_ANY_MODEL=0

# Personal research roles via internal Harness SDK bridge (server only).
# Compose: --profile harness-workers; use http://harness-workers:3090 inside kt.
HARNESS_WORKER_URL=
HARNESS_WORKER_TOKEN=
HARNESS_WORKER_API_KEY=
HARNESS_WORKER_BASE_URL=https://api.deepseek.com
HARNESS_WORKER_MODEL=deepseek-chat

# Identity phase 1: explicit cutover only after backup + migration + verified import.
AUTH_STORE=json
AUTH_MAINTENANCE=0
DATABASE_AUTH_URL=
DATABASE_APP_URL=
# One-shot operations only. NEVER pass migration owner URL to portal runtime.
DATABASE_MIGRATION_URL=
DATABASE_WORKER_URL=
VERIFICATION_CODE_SECRET=
# S3-compatible storage; private endpoint until a later authenticated upload API rollout.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=keyantong-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TASK_STREAM=kt:keyantong:events

# Set only after shared CPU worker is deployed and schemas 004–006 are applied.
OMICS_ENABLED=0
