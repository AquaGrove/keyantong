{
  "manifest_version": 3,
  "name": "科研通本机助手（开发预览）",
  "version": "0.4.0",
  "description": "连接已登录的 NCBI 页面与本机 Aspera；数据、私钥和会话留在本机。",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://submit.ncbi.nlm.nih.gov/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开科研通 NCBI 本机助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://submit.ncbi.nlm.nih.gov/subs/sra/*"
      ],
      "js": [
        "portal.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://keyantong.online/*"
      ],
      "js": [
        "local-files.js"
      ],
      "run_at": "document_start"
    }
  ]
}
